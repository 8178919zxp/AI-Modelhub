# =============================================================================
# AI ModelHub — 环境变量示例（根目录）
#
# 本文件只做「需要配置哪些变量」的说明，不是可直接加载的 .env。
# 三种启动方式读取的变量文件不同：
#
#   1) Docker Compose（推荐用于演示/部署）
#      → 真正的变量文件是 deploy/.env，请复制 deploy/.env.example 后填写。
#
#   2) 本地手动启动
#      → 后端读取 backend/src/main/resources/application.yml
#        （由 application-example.yml 复制而来，本身也支持 ${ENV} 覆盖）
#      → 前端读取 frontend/.env.development
#
#   3) 生产部署（profile=prod）
#      → 下列变量必须由运行环境注入；缺失或使用弱口令会被
#        ProductionSafetyValidator 拒绝启动。
#
# 任何真实口令 / 密钥都不得提交到 Git。application*.yml（除模板与
# 无凭据的 dev/docker/prod）、deploy/.env、frontend/.env* 均已被 .gitignore 排除。
# =============================================================================

# ── 必填：数据库 ─────────────────────────────────────────────────────────────
# MySQL root 口令
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_PASSWORD
# 本地非容器运行时可按需覆盖（默认 localhost:3306 / root）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root

# ── 必填：JWT 签名密钥 ───────────────────────────────────────────────────────
# Base64 编码，解码后 >= 32 字节。生成：openssl rand -base64 32
JWT_SECRET=CHANGE_ME_BASE64_32BYTES

# ── 必填：MinIO 对象存储（预测图片存储，可不部署）───────────────────────────
# access key >= 3 字符，secret >= 8 字符
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
# 本地启动时使用；容器内由 application-docker.yml 固定为 http://minio:9000
# MINIO_ENDPOINT=http://localhost:9000

# ── 必填：ModelHub Copilot / DeepSeek ───────────────────────────────────────
# Agent 对话使用的大模型密钥，只从环境变量读取，禁止写进 application*.yml。
# 获取：https://platform.deepseek.com/api_keys
# 未配置时：平台其它功能全部正常，仅 Agent 对话返回「未配置密钥」提示。
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
# 模型标识，默认 deepseek-flash
# DEEPSEEK_MODEL=deepseek-flash
# 接口地址（默认官方），一般不需要改
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 可选：Redis（默认 localhost:6379；容器内为 redis:6379）───────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ── 可选：JWT 行为 ───────────────────────────────────────────────────────────
# 有效期（毫秒），默认 86400000（24h）；生产建议 7200000（2h）
# JWT_EXPIRATION_MS=86400000
# 是否启用令牌黑名单（登出/改密后真正吊销），dev/docker/prod 默认 true
# APP_JWT_BLACKLIST_ENABLED=true

# ── 可选：演示账号初始口令 ───────────────────────────────────────────────────
# 仅在 sys_user 表为空时用于创建 admin / demo 账号，默认 123456。
# 对外演示前请改成自己的口令。
# APP_BOOTSTRAP_DEFAULT_USER_PASSWORD=123456

# ── 可选：服务地址 ───────────────────────────────────────────────────────────
# 推理服务地址（本地默认 http://localhost:8001；容器内 http://model-service:8001）
# MODEL_SERVICE_BASE_URL=http://localhost:8001
# 生成历史图片 URL 时使用的、浏览器可达的后端地址
# FILE_PROXY_BASE_URL=http://localhost:8080
# 允许的浏览器来源，逗号分隔。前端独立端口 / 独立域名访问后端时必须配，
# 否则 POST 会被 Spring 判为非法 CORS 请求（403 Invalid CORS request）。
# 前端由 Nginx 与后端同源暴露时不受影响。不要填 "*"。
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 推理服务是否允许在首次调用时自动下载 U²-Net 权重（176 MB）。默认 false：
# 缺 weights/u2net.onnx 时判为不可用并返回 503，不联网、不留缓存。
# U2NET_ALLOW_DOWNLOAD=false

# ── 可选：前端（构建期注入，Vite 只认 VITE_ 前缀）───────────────────────────
# 本地开发：指向本机后端
# VITE_BACKEND_BASE_URL=http://localhost:8080
# 容器部署：留空，由 Nginx 同源反代 /api
# VITE_BACKEND_BASE_URL=

# =============================================================================
# AI ModelHub — Docker Compose 环境变量模板
#
# 用法：
#   cp deploy/.env.example deploy/.env
#   然后替换每个值；deploy/.env 已被 .gitignore 排除。
#
# deploy/docker-compose.yml 对以下变量使用 ${VAR:?} 语法：
# 缺失时 `docker compose up` 会直接报错退出（fail-fast），
# 不会静默使用示例口令。
# =============================================================================

# MySQL（compose 内 root 账号；请使用强口令）
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_PASSWORD

# MinIO（对象存储；access key 至少 3 字符，secret 至少 8 字符）
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# JWT 签名密钥：Base64 编码、解码后 >= 32 字节
# 生成：openssl rand -base64 32
JWT_SECRET=CHANGE_ME_BASE64_32BYTES

# ModelHub Copilot / DeepSeek（可选）
# 不填时 compose 会传入 sk-not-configured，平台其它功能正常，
# Agent 对话返回「未配置大模型密钥」提示。
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-flash

# 可选
# JWT_EXPIRATION_MS=7200000
# REDIS_PASSWORD=
# APP_JWT_BLACKLIST_ENABLED=true

# 允许的浏览器来源（逗号分隔）。前端与后端同源（都用 Nginx :80）时不需要配；
# 若把前端改到其它端口、或前后端分域名部署，必须把前端地址加进来，
# 否则登录等 POST 请求会返回 403 Invalid CORS request。不要填 "*"。
# APP_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# 推理服务是否允许在首次调用时自动下载 U²-Net 权重（176 MB）。默认 false：
# 缺 weights/u2net.onnx 时健康检查标 error、抠图接口返回 503，不联网也不留缓存。
# U2NET_ALLOW_DOWNLOAD=false

# =============================================================================
# AI ModelHub — 前端环境变量模板
#
# 用法：
#   cp frontend/.env.example frontend/.env.development   # 本地开发
#   真实 .env.development / .env.production 已被 .gitignore 排除
#
# 说明：
#   开发：后端直连 http://localhost:8080
#   生产：前端由 nginx 反代 /api → backend:8080，因此留空表示同源
# =============================================================================

# 后端 API 基地址（留空 = 同源，走 nginx/反代）
VITE_BACKEND_BASE_URL=http://localhost:8080

# 仅用于本地调试模型服务时参考，前端不直接调用
VITE_MODEL_SERVICE_BASE_URL=http://localhost:8001
